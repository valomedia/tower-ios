#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly swiftlint="Pods/SwiftLint/swiftlint"

if [[ ! -x "${swiftlint}" ]]; then
  echo "SwiftLint is not installed. Run 'pod install --repo-update' to install it." >&2
  exit 1
fi

exec "${swiftlint}" lint --config .swiftlint.yml
